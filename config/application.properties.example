# Sunrise Dental Clinic - local configuration
#
# Copy this file to config/application.properties and fill in your own values.
# The real file is git-ignored: credentials are never committed.
#
# Every key can also be supplied as an environment variable, which is how the
# M6 deployment target provides them:
#   SERVER_PORT, DB_URL, DB_USER, DB_PASSWORD

server.port=8080
server.threads=16

# WAMP's MySQL listens on 3306 by default; MAMP uses 8889.
db.url=jdbc:mysql://localhost:3306/sunrise_clinic?useSSL=false&serverTimezone=Asia/Colombo
db.user=root
db.password=
db.pool.size=10
