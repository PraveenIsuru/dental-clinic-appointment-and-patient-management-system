{
  "info": {
    "name": "Sunrise Dental Clinic API v1",
    "description": "REST API for the Sunrise Dental Clinic appointment and patient management system (CIS6003 WRIT1).\n\nEvidence for Task B requirement (i), 'a distributed application with web services': every endpoint here is independently consumable, with no browser involved.\n\n## How to use it\n\n1. Set the `baseUrl` variable (default http://localhost:8080).\n2. Run **Sign in** — Postman keeps the SESSIONID cookie automatically.\n3. Run **Get session** — its test script stores the CSRF token into the `csrfToken` variable.\n4. Every POST then works; the token is sent in the X-CSRF-Token header.\n\nRun the whole collection in order with the Collection Runner to exercise the full booking-to-billing flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "csrfToken", "value": "" },
    { "key": "appointmentNo", "value": "" },
    { "key": "billNo", "value": "" }
  ],
  "item": [
    {
      "name": "0 · Authentication",
      "item": [
        {
          "name": "Sign in (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin" },
                { "key": "password", "value": "Admin@123" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "description": "Form login. Postman stores the SESSIONID cookie; the API uses the same session as the web interface."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('redirects to a dashboard', function () {",
                  "    pm.expect(pm.response.code).to.eql(303);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get session and CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/session",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "session"]
            },
            "description": "Returns who you are and the CSRF token every POST needs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', body.csrfToken);",
                  "pm.test('carries a role', function () {",
                  "    pm.expect(body.role).to.be.oneOf(['ADMIN', 'DENTIST', 'PATIENT']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthenticated call is 401 JSON",
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "SESSIONID=not-a-real-session" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments"]
            },
            "description": "An API client must receive JSON, not a redirect to an HTML login page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401, not a redirect', function () { pm.response.to.have.status(401); });",
                  "pm.test('body is JSON', function () {",
                  "    pm.expect(pm.response.json().error).to.eql('unauthenticated');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Reference data",
      "item": [
        {
          "name": "List dentists",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dentists",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "dentists"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns dentists with session hours', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.count).to.be.above(0);",
                  "    pm.expect(body.dentists[0]).to.have.property('sessionStart');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List treatments",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/treatments",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "treatments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('prices are numbers, not strings', function () {",
                  "    pm.expect(pm.response.json().treatments[0].baseCost).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dentist availability",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dentists/1/availability?date=2026-10-01",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dentists", "1", "availability"],
              "query": [{ "key": "date", "value": "2026-10-01" }]
            },
            "description": "The Check Dentist Availability use case, exposed as a service."
          }
        }
      ]
    },
    {
      "name": "2 · Appointments",
      "item": [
        {
          "name": "Book an appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Postman Test Patient\",\n  \"address\": \"14/3 Temple Road, Nugegoda\",\n  \"contactNumber\": \"0771234567\",\n  \"dentistId\": 1,\n  \"treatmentId\": 2,\n  \"date\": \"2026-10-01\",\n  \"time\": \"09:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Location header names the new resource', function () {",
                  "    pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/appointments/');",
                  "});",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set('appointmentNo', body.appointmentNo);",
                  "pm.test('number follows APT-YYYY-NNNN', function () {",
                  "    pm.expect(body.appointmentNo).to.match(/^APT-\\d{4}-\\d{4}$/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Double booking is refused with suggestions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Clash Test\",\n  \"address\": \"1 Other Road\",\n  \"contactNumber\": \"0779876543\",\n  \"dentistId\": 1,\n  \"treatmentId\": 2,\n  \"date\": \"2026-10-01\",\n  \"time\": \"09:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments"]
            },
            "description": "The same dentist, date and time. Refused by uq_dentist_slot, with the nearest free times offered."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', function () { pm.response.to.have.status(409); });",
                  "pm.test('offers alternatives', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.error).to.eql('slot_unavailable');",
                  "    pm.expect(body.suggestions).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Validation failure lists every bad field",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"\",\n  \"address\": \"\",\n  \"contactNumber\": \"not-a-phone\",\n  \"dentistId\": 1,\n  \"treatmentId\": 2,\n  \"date\": \"2020-01-01\",\n  \"time\": \"09:17\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', function () { pm.response.to.have.status(422); });",
                  "pm.test('reports all failures at once', function () {",
                  "    var fields = pm.response.json().fields;",
                  "    pm.expect(Object.keys(fields).length).to.be.above(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the appointment",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments/{{appointmentNo}}",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments", "{{appointmentNo}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('no password hash anywhere in the response', function () {",
                  "    pm.expect(pm.response.text()).to.not.include('pbkdf2');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown number is 404",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments/APT-1999-9999",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments", "APT-1999-9999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete the treatment",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments/{{appointmentNo}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "appointments", "{{appointmentNo}}", "complete"]
            },
            "description": "Makes the appointment billable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('now billable', function () {",
                  "    pm.expect(pm.response.json().billable).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 · Billing",
      "item": [
        {
          "name": "Issue a bill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentNo\": \"{{appointmentNo}}\",\n  \"quantity\": 1,\n  \"discountPercent\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bills",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "bills"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set('billNo', body.billNo);",
                  "pm.test('itemised', function () {",
                  "    pm.expect(body.lineItems).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('total = subtotal - discount + tax', function () {",
                  "    var c = body.charges;",
                  "    pm.expect(c.total).to.eql(c.subtotal - c.discount + c.tax);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Discount above the cap is refused",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentNo\": \"{{appointmentNo}}\",\n  \"quantity\": 1,\n  \"discountPercent\": 40\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bills",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "bills"]
            },
            "description": "Enforced by BillingService and again by trg_bill_before_insert."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([409, 422]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the bill",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bills/{{billNo}}",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "bills", "{{billNo}}"]
            }
          }
        },
        {
          "name": "Record payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bills/{{billNo}}/pay",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "bills", "{{billNo}}", "pay"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('now paid', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('PAID');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 · Reports",
      "item": [
        {
          "name": "Daily operations",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/daily",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "reports", "daily"]
            }
          }
        },
        {
          "name": "Revenue by treatment (sp_daily_revenue_report)",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/revenue",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "reports", "revenue"]
            },
            "description": "Computed entirely by the stored procedure; no Java aggregation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('names the stored procedure', function () {",
                  "    pm.expect(pm.response.json().source).to.eql('sp_daily_revenue_report');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dentist workload (vw_dentist_workload)",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/workload",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "reports", "workload"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('names the view', function () {",
                  "    pm.expect(pm.response.json().source).to.eql('vw_dentist_workload');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
